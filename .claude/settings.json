{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(java -version)",
      "Bash(docker info)",
      "Bash(docker version *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker exec pg *)",
      "Bash(docker run -d --name pg *)",
      "Bash(docker rm -f pg)",
      "Bash(curl -s localhost:8080/*)",
      "Bash(curl -sf localhost:8080/*)",
      "Bash(curl -sf -X POST * localhost:8080/*)",
      "Bash(./target/mn-testcontainers-shenanigans)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
